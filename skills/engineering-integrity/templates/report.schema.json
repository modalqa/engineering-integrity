{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "requirementsComplete": {
          "type": "boolean"
        },
        "upstreamWorkflow": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source",
        "requirementsComplete"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "VERIFIED WITH WARNINGS",
        "BLOCKED",
        "UNVERIFIED"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "audit",
        "correction",
        "full"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 0
        },
        "maxRepeatedAttempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxIterations",
        "maxRepeatedAttempts"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Partially Verified",
              "Not Implemented",
              "Failed",
              "Not Verifiable"
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "execution",
              "inspection"
            ]
          },
          "implementation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "description",
          "mandatory",
          "status",
          "verification",
          "implementation",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "execution",
              "inspection",
              "claim"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "observed",
              "unavailable"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "snapshot",
          "capturedAt",
          "kind",
          "outcome",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "verificationCriteria": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "enum": [
              "execution",
              "inspection"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "in-progress",
              "resolved",
              "reopened",
              "justified",
              "unverified"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verificationEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "acceptedBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "fingerprint",
          "title",
          "category",
          "severity",
          "component",
          "description",
          "expected",
          "actual",
          "recommendation",
          "verificationCriteria",
          "verification",
          "state",
          "attempts",
          "evidenceIds",
          "verificationEvidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "correctedFindingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "failedFindingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "round",
          "snapshot",
          "correctedFindingIds",
          "failedFindingIds",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "skipped"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "required",
          "outcome",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unauthorized",
            "unknown"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "independence": {
      "type": "string",
      "enum": [
        "independent-reviewer",
        "fresh-context",
        "same-agent-pass"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stopReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "task",
    "snapshot",
    "status",
    "mode",
    "limits",
    "requirements",
    "evidence",
    "findings",
    "iterations",
    "checks",
    "scope",
    "independence",
    "limitations",
    "stopReason"
  ],
  "additionalProperties": false
}
